# sha256(пароль приложения) в hex — PWA хэширует пароль на клиенте и шлёт хэш в X-App-Key.
# Пусто = без аутентификации (только dev). Получить хэш: python3 -c "import hashlib;print(hashlib.sha256('пароль'.encode()).hexdigest())"
APP_SHARED_SECRET=
AUTH_FAIL_LIMIT=8
AUTH_FAIL_WINDOW_SEC=600
AUTH_LOCKOUT_SEC=1800

ALLOWED_ORIGINS=https://dend99.github.io,http://localhost:8099,http://127.0.0.1:8099,http://localhost:8000,http://127.0.0.1:8000
